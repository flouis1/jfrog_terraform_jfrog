jfrog_url = "https://your-instance.jfrog.io"
ci_user_name = "ci-user"
ci_user_email = "ci-user@example.com"
oidc_issuer_url = "https://gitlab.com/" # For GitLab SaaS instance
oidc_settings_name = "gitlab-oidc-configuration"
identity_mapping_name = "my-gitlab-project-name"
identity_mapping_priority = 1
claims_json_path = "./exampleClaims.json"
expiry_seconds = 600
